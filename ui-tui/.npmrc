# Supply-chain hardening: disable npm lifecycle script execution by default.
#
# Effect: `npm install` and `npm ci` will still resolve, download, unpack,
# and place packages in node_modules — but the `preinstall`, `install`,
# and `postinstall` scripts declared in any package's package.json will
# NOT run automatically. Historically the dominant execution vector for
# npm supply-chain malware (event-stream, ua-parser-js, several 2024-26
# incidents).
#
# Cost: packages that legitimately need install-time setup (esbuild's
# platform binary download, native module compilation via node-gyp) will
# install but not work until explicitly rebuilt:
#
#     npm rebuild esbuild           # named, eyes-open opt-in per package
#     npm rebuild                   # all native modules (broader)
#
# The arm64-fix handoff (hermes-m5-arm64-runtime-fix-handoff.v4.md) and
# the pre-commit hook in scripts/git-hooks/ assume this setting is in
# effect.
ignore-scripts=true
